<?xml version="1.0" encoding="utf-8"?>
<!-- Remaps buttons of the remote control (YouTube, Netflix, Live TV ...) on Android TV / Google TV
     devices; device profiles (Profiles.java) know the buttons of known remotes.
     An AccessibilityService sees the key presses before the system passes them to their factory
     targets. No other background service. Texts: English (values) and German (values-de). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.chiq.keys"
    android:versionCode="3"
    android:versionName="1.2">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Webhooks (e.g. Home Assistant on the local network, usually plain http) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updater (PackageInstaller); the user confirms every installation -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- See launchable apps (target picker and start by package name) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Live TV apps (KeyMap.KNOWN_LIVE_TV) and TV settings -->
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.google.android.tv" />
        <package android:name="com.android.tv" />
        <package android:name="com.android.tv.settings" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <service
            android:name=".KeyService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/KeysTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Installer status of an in-app update -->
        <receiver android:name=".Updater$Result" android:exported="false" />

        <!-- Configuration via adb; only shell/system hold DUMP, so regular apps cannot send to it -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
