<?xml version="1.0" encoding="utf-8"?>
<!-- Filters key events. The only accessibility events are window changes (foreground app, needed
     for opening the program guide); no window content (saves RAM and CPU). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/service_desc"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:settingsActivity="de.diesteinhose.tvremotebuttons.SettingsActivity" />
