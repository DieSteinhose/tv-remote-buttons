    <!-- Upload buttons (device report) -->
    <string name="section_help">Help improve</string>
    <string name="upload_row">Upload buttons</string>
    <string name="upload_row_sub">Helps to add a profile for this TV – no account needed</string>
    <string name="upload_body">Send the buttons of your remote to the developer so that the app can recognize this TV and its remote in the future. First you map the buttons: which button is Netflix, YouTube, Live TV and so on.\n\nSent: TV model and Android version, your remotes (name, vendor and product ID) and the button mapping (keycodes, types, own names). Not sent: your apps, assignments or addresses.\n\nThe report becomes a public issue on GitHub. One report per TV and day.</string>
