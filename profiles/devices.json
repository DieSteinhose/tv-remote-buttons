{
  "schema": 2,
  "remotes": [
    {
      "id": "chiq_tvc0gwbt",
      "title": "CHiQ remote TVC0GWBT (Bluetooth and infrared)",
      "notes": "Remote of CHiQ Google TVs (tested on GTVU65). It sends via Bluetooth (TVC0GWBT) and, without a Bluetooth connection, via infrared to the TV's IR receiver (MStar Smart TV IR Receiver) with the same keycodes. Via Bluetooth it sends MEDIA_SKIP_FORWARD after every button as a release marker, so that key is protected. Limited to CHiQ TVs because the IR receiver is built into many MediaTek TVs whose software maps infrared codes differently.",
      "legacy": [
        "chiq_mt58"
      ],
      "match": {
        "inputs": [
          {
            "name": "TVC0GWBT",
            "vendor": "0x1d5a",
            "product": "0xc082"
          },
          {
            "name": "MStar Smart TV IR Receiver",
            "vendor": "0x3697",
            "product": "0x0001"
          }
        ],
        "tvs": [
          "chiq_mt58"
        ]
      },
      "protect": [
        "MEDIA_SKIP_FORWARD"
      ],
      "keys": [
        {
          "key": "TV_INPUT_COMPOSITE_1",
          "type": "youtube",
          "default": "@system"
        },
        {
          "key": "STEM_1",
          "type": "netflix",
          "default": "@system"
        },
        {
          "key": "FEATURED_APP_1",
          "type": "livetv",
          "default": "@livetv"
        },
        {
          "key": "TV_INPUT_COMPONENT_1",
          "type": "prime",
          "default": "@system"
        },
        {
          "key": "ALL_APPS",
          "type": "apps",
          "default": "@system"
        },
        {
          "key": "GUIDE",
          "type": "guide",
          "default": "@epg",
          "name": {
            "en": "Guide (2nd Live TV button)",
            "de": "Guide (2. Live-TV-Taste)"
          }
        },
        {
          "key": "NOTIFICATION",
          "type": "settings",
          "default": "com.android.tv.settings/com.android.tv.settings.MainSettings"
